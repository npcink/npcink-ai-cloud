diff --git a/tests/unit/title-rename.test.cjs b/tests/unit/title-rename.test.cjs
new file mode 100644
index 0000000..6c12da3
--- /dev/null
+++ b/tests/unit/title-rename.test.cjs
@@ -0,0 +1,267 @@
+/** Executes the real Rename handler and title utility with deferred Ability responses. */
+const { test } = require( 'node:test' );
+const assert = require( 'node:assert/strict' );
+const { readFileSync } = require( 'node:fs' );
+const vm = require( 'node:vm' );
+const ts = require( 'typescript' );
+
+function fixture( options = {} ) {
+	const state = {
+		postId: 42,
+		title: 'Saved title',
+		excerpt: '',
+		content: 'Current draft body',
+		calls: [],
+		notices: [],
+		writes: [],
+	};
+	const input = {
+		value: 'Unsaved name',
+		connected: true,
+		focus() {},
+		select() {},
+	};
+	const form = { connected: true, querySelector: () => input };
+	const editor = {
+		getCurrentPostId: () => state.postId,
+		getEditedPostContent: () => state.content,
+		getEditedPostAttribute: ( key ) => state[ key ],
+	};
+	const actions = {
+		removeNotice: () => {
+			state.notices = [];
+		},
+		createErrorNotice: ( content, options ) =>
+			state.notices.push( { content, ...options } ),
+	};
+	const selectors = ( store ) =>
+		store === 'editor' ? editor : { getNotices: () => state.notices };
+	let release, reject;
+	const response = new Promise( ( resolve, fail ) => {
+		release = resolve;
+		reject = fail;
+	} );
+	const slots = [];
+	let cursor = 0;
+	const cleanups = [];
+	const element = {
+		useState( initial ) {
+			const id = cursor++;
+			if ( ! ( id in slots ) ) {
+				slots[ id ] = initial;
+			}
+			return [
+				slots[ id ],
+				( value ) => {
+					slots[ id ] = value;
+				},
+			];
+		},
+		useRef( initial ) {
+			const id = cursor++;
+			if ( ! ( id in slots ) ) {
+				slots[ id ] = { current: initial };
+			}
+			return slots[ id ];
+		},
+		useEffect( effect ) {
+			const id = cursor++;
+			if ( ! ( id in slots ) ) {
+				slots[ id ] = true;
+				cleanups.push( effect() );
+			}
+		},
+		createPortal: ( child, target ) => ( {
+			type: 'portal',
+			props: { children: child, target },
+		} ),
+	};
+	const jsx = ( type, props ) => ( { type, props } );
+	const mocks = {
+		'react/jsx-runtime': { jsx, jsxs: jsx },
+		'@wordpress/element': element,
+		'@wordpress/components': { Button: 'Button', Notice: 'Notice' },
+		'@wordpress/data': {
+			useSelect: ( callback ) => callback( selectors ),
+			select: selectors,
+			dispatch: () => actions,
+		},
+		'@wordpress/editor': {
+			store: 'editor',
+			PostTypeSupportCheck: 'Support',
+		},
+		'@wordpress/notices': { store: 'notices' },
+		'@wordpress/i18n': {
+			__: ( text ) => text,
+			sprintf: ( text, n ) => text.replace( '%d', n ),
+		},
+		'../../../utils/provider-status': {
+			ensureProvider: () => {
+				if ( options.noProvider ) {
+					actions.createErrorNotice( 'Connect a provider first', {
+						id: utils.NOTICE_ID,
+						actions: [
+							{
+								label: 'Manage Connectors',
+								url: '/wp-admin/options-connectors.php',
+							},
+						],
+					} );
+					return false;
+				}
+				return true;
+			},
+		},
+		'../../../utils/character-count': { hasMinimumContent: () => true },
+		'../../utils/run-ability': {
+			runAbility: async ( ability, value ) => {
+				state.calls.push( { ability, value } );
+				return response;
+			},
+		},
+	};
+	function load( file ) {
+		const exports = {};
+		const source = ts.transpileModule( readFileSync( file, 'utf8' ), {
+			compilerOptions: {
+				module: ts.ModuleKind.CommonJS,
+				target: ts.ScriptTarget.ES2022,
+				jsx: ts.JsxEmit.ReactJSX,
+			},
+		} ).outputText;
+		vm.runInNewContext( source, {
+			exports,
+			require( id ) {
+				if ( ! mocks[ id ] ) {
+					throw new Error( `Unexpected import ${ id }` );
+				}
+				return mocks[ id ];
+			},
+			document: { body: { contains: ( node ) => node.connected } },
+			window: { aiTitleGenerationData: { enabled: true } },
+		} );
+		return exports;
+	}
+	const utils = load( 'src/experiments/title-generation/utils.ts' );
+	mocks[ '../utils' ] = {
+		...utils,
+		setInputValue( target, value ) {
+			target.value = value;
+			state.writes.push( value );
+		},
+	};
+	const Component = load(
+		'src/experiments/title-generation/components/RenameModalButton.tsx'
+	).default;
+	function render() {
+		cursor = 0;
+		return Component( { inputElement: input, formElement: form } );
+	}
+	function find( node, type ) {
+		if ( ! node || typeof node !== 'object' ) {
+			return undefined;
+		}
+		if ( node.type === type ) {
+			return node;
+		}
+		return [ node.props?.children ]
+			.flat()
+			.map( ( child ) => find( child, type ) )
+			.find( Boolean );
+	}
+	return {
+		state,
+		input,
+		form,
+		release,
+		reject,
+		click: () => find( render(), 'Button' ).props.onClick(),
+		notice: () => find( render(), 'Notice' ),
+		close: () => {
+			form.connected = input.connected = false;
+			cleanups.forEach( ( fn ) => fn?.() );
+		},
+	};
+}
+
+test( 'Rename uses current draft and only fills the modal after one request under repeated clicks', async () => {
+	const f = fixture();
+	const first = f.click();
+	await f.click();
+	assert.equal( f.state.calls.length, 1 );
+	assert.equal( f.state.calls[ 0 ].value.current_title, 'Unsaved name' );
+	f.release( { title: 'Suggested name' } );
+	await first;
+	assert.equal( f.input.value, 'Suggested name' );
+	assert.equal( f.state.title, 'Saved title' );
+	assert.deepEqual( f.state.writes, [ 'Suggested name' ] );
+} );
+for ( const field of [ 'postId', 'title', 'excerpt', 'content' ] ) {
+	test( `Rename preserves input and shows an in-modal recovery when ${ field } changes`, async () => {
+		const f = fixture();
+		const pending = f.click();
+		f.state[ field ] = field === 'postId' ? 43 : 'Author changed draft';
+		f.release( { title: 'Old-context suggestion' } );
+		await pending;
+		assert.equal( f.input.value, 'Unsaved name' );
+		assert.equal( f.state.writes.length, 0 );
+		assert.match( f.notice().props.children, /current draft/ );
+	} );
+}
+test( 'Rename preserves manual name edits while generating', async () => {
+	const f = fixture();
+	const pending = f.click();
+	f.input.value = 'Author typed name';
+	f.release( { title: 'Suggestion' } );
+	await pending;
+	assert.equal( f.input.value, 'Author typed name' );
+	assert.match( f.notice().props.children, /Your edit was kept/ );
+} );
+test( 'Rename duplicate recovery names controls that exist in this modal', async () => {
+	const f = fixture();
+	const pending = f.click();
+	f.release( { title: 'Suggested name' } );
+	await pending;
+	await f.click();
+	assert.match( f.notice().props.children, /Edit the name and regenerate/ );
+	assert.doesNotMatch( f.notice().props.children, /guidance/ );
+	assert.equal( f.state.calls.length, 2 );
+	assert.equal( f.input.value, 'Suggested name' );
+} );
+for ( const fail of [ false, true ] ) {
+	test( `closed Rename ignores a late ${
+		fail ? 'failure' : 'success'
+	}`, async () => {
+		const f = fixture();
+		const pending = f.click();
+		f.close();
+		if ( fail ) {
+			f.reject( new Error( 'Late failure' ) );
+		} else {
+			f.release( { title: 'Late result' } );
+		}
+		await pending;
+		assert.equal( f.state.writes.length, 0 );
+		assert.equal( f.state.notices.length, 0 );
+	} );
+}
+test( 'Rename exposes transport failure inside the modal without another call', async () => {
+	const f = fixture();
+	const pending = f.click();
+	f.reject( new Error( 'Request failed; retry from this modal' ) );
+	await pending;
+	assert.match( f.notice().props.children, /Request failed/ );
+	assert.equal( f.state.calls.length, 1 );
+	assert.equal( f.input.value, 'Unsaved name' );
+} );
+
+test( 'Rename exposes missing-provider recovery link within the modal without calling Ability', async () => {
+	const f = fixture( { noProvider: true } );
+	await f.click();
+	assert.equal( f.state.calls.length, 0 );
+	assert.match( f.notice().props.children, /Connect a provider/ );
+	assert.equal(
+		f.notice().props.actions[ 0 ].url,
+		'/wp-admin/options-connectors.php'
+	);
+} );
