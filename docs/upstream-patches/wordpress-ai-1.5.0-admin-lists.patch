diff --git a/tests/unit/admin-lists.test.cjs b/tests/unit/admin-lists.test.cjs
new file mode 100644
index 0000000..4bfc10a
--- /dev/null
+++ b/tests/unit/admin-lists.test.cjs
@@ -0,0 +1,59 @@
+/** Replays persisted duplicate columns and tests locale labels without mutating IDs. */
+const { test } = require( 'node:test' );
+const assert = require( 'node:assert/strict' );
+const { readFileSync } = require( 'node:fs' );
+const vm = require( 'node:vm' );
+const ts = require( 'typescript' );
+function load( file, stubs = {}, window = {} ) {
+	const exports = {};
+	vm.runInNewContext( ts.transpileModule( readFileSync( file, 'utf8' ), { compilerOptions: {
+		target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.CommonJS, jsx: ts.JsxEmit.React, jsxFactory: 'h',
+	} } ).outputText, {
+		exports, window, Set, h: ( tag, props, ...children ) => ( { tag, props, children } ),
+		require: ( id ) => stubs[ id ] || { isJsonRecord: ( v ) => v !== null && typeof v === 'object' && ! Array.isArray( v ) },
+	} );
+	return exports;
+}
+const base = { type: 'table', fields: [ 'description', 'slug', 'provider', 'description' ], page: 1, perPage: 20,
+	sort: { field: 'name', direction: 'asc' }, layout: { styles: { description: { width: '50%' } } } };
+test( 'legacy duplicate fields recover while hidden and unavailable extension preferences survive', () => {
+	const f = load( 'src/experiments/abilities-explorer/view-storage.ts' );
+	const saved = { type: 'table', fields: [ 'slug', 'description', 'missing', 'description', 'missing' ],
+		seenFields: [ 'slug', 'description', 'provider', 'missing', 'hidden' ],
+		sort: { field: 'slug', direction: 'desc' }, perPage: 50, layout: { density: 'compact', styles: { slug: { width: '22%' } } } };
+	const r = f.restoreView( base, saved, [ 'slug', 'description', 'provider', 'hidden', 'new' ], [ 'description', 'provider', 'hidden', 'new', 'new' ], [ 'table' ] );
+	assert.deepEqual( Array.from( r.view.fields ), [ 'slug', 'description', 'missing', 'new' ] );
+	assert.equal( r.view.perPage, 50 ); assert.equal( r.view.sort.direction, 'desc' );
+	assert.equal( r.view.layout.density, 'compact' );
+	assert.equal( r.view.layout.styles.slug.width, '22%' );
+	assert.equal( r.view.layout.styles.description.width, '50%' );
+	assert.equal( new Set( r.seenFields ).size, r.seenFields.length );
+	const defaults = f.restoreView( base, null, [], [ 'description', 'slug' ], [ 'table' ] );
+	assert.deepEqual( Array.from( defaults.view.fields ), [ 'description', 'slug', 'provider' ] );
+} );
+test( 'saving repairs stored duplicates without deleting temporarily unavailable columns', () => {
+	let stored = JSON.stringify( { version: 1, type: 'table', fields: [ 'slug', 'missing', 'missing', 'description' ], seenFields: [ 'missing' ], sort: null, layout: {}, perPage: 20 } );
+	const f = load( 'src/experiments/abilities-explorer/view-storage.ts', {}, { localStorage: { getItem: () => stored, setItem: ( k, v ) => { stored = v; } } } );
+	f.saveView( { ...base, fields: [ 'slug', 'slug' ] }, [ 'slug', 'slug' ], [ 'slug', 'description' ] );
+	const r = JSON.parse( stored );
+	assert.deepEqual( r.fields, [ 'slug', 'missing' ] );
+	assert.deepEqual( r.seenFields, [ 'slug', 'missing' ] );
+	assert.equal( r.fields.includes( 'description' ), false );
+} );
+test( 'known log enums use UI locale while unknown extension codes remain exact', () => {
+	const f = load( 'src/admin/ai-request-logs/labels.ts', { '@wordpress/i18n': { __: ( s, d ) => `${ d }:${ s }` } } );
+	for ( const [ value, label ] of [ [ 'success', 'Success' ], [ 'timeout', 'Timeout' ], [ 'text', 'Text' ], [ 'ai_client', 'AI Client' ] ] ) {
+		assert.equal( f.getLogLabel( value ), `ai:${ label }` );
+	}
+	assert.equal( f.getLogLabel( 'Vendor_HTTP_v2' ), 'Vendor_HTTP_v2' );
+} );
+test( 'origin badges translate raw REST labels and retain explicit custom labels', () => {
+	const f = load( 'src/experiments/abilities-explorer/components/ProviderBadge.tsx', {
+		'@wordpress/i18n': { __: ( s ) => `译:${ s }` },
+		'../settings': { getSettings: () => ( { providerLabels: { Plugin: 'Plugin', Custom: 'Custom Label' } } ) },
+	} );
+	assert.equal( f.default( { provider: 'Plugin', label: 'Plugin' } ).children[ 0 ], '译:Plugin' );
+	assert.equal( f.default( { provider: 'Plugin', label: 'Explicit Label' } ).children[ 0 ], 'Explicit Label' );
+	assert.equal( f.getProviderLabel( 'Custom' ), 'Custom Label' );
+	assert.equal( f.getProviderLabel( 'Vendor_v2' ), 'Vendor_v2' );
+} );
