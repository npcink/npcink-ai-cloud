--- /dev/null
+++ b/src/admin/ai-request-logs/labels.ts
@@ -0,0 +1,40 @@
+/**
+ * WordPress dependencies
+ */
+import { __ } from '@wordpress/i18n';
+
+/**
+ * Localizes known log enums, leaving extension codes intact for investigation.
+ * Provider, model, operation and source names are deliberately not enums here.
+ *
+ * @param value The stored enum value.
+ * @return The UI label, or the original unknown code.
+ */
+export function getLogLabel( value: string ): string {
+	switch ( value ) {
+		case 'success':
+			return __( 'Success', 'ai' );
+		case 'error':
+			return __( 'Error', 'ai' );
+		case 'timeout':
+			return __( 'Timeout', 'ai' );
+		case 'ai_client':
+			return __( 'AI Client', 'ai' );
+		case 'mcp_tool':
+			return __( 'MCP Tool', 'ai' );
+		case 'ability':
+			return __( 'Ability', 'ai' );
+		case 'text':
+			return __( 'Text', 'ai' );
+		case 'image':
+			return __( 'Image', 'ai' );
+		case 'audio':
+			return __( 'Audio', 'ai' );
+		case 'embeddings':
+			return __( 'Embeddings', 'ai' );
+		case 'metadata':
+			return __( 'Metadata', 'ai' );
+		default:
+			return value;
+	}
+}
