diff --git a/tests/unit/title-generation.test.cjs b/tests/unit/title-generation.test.cjs
new file mode 100644
index 0000000..d7ade4d
--- /dev/null
+++ b/tests/unit/title-generation.test.cjs
@@ -0,0 +1,41 @@
+/** Executes the real title utility with only its WordPress Ability transport stubbed. */
+const { test } = require( 'node:test' );
+const assert = require( 'node:assert/strict' );
+const { readFileSync } = require( 'node:fs' );
+const vm = require( 'node:vm' );
+const ts = require( 'typescript' );
+function fixture( response ) {
+	const calls = [];
+	const exports = {};
+	const source = readFileSync( 'src/experiments/title-generation/utils.ts', 'utf8' );
+	vm.runInNewContext( ts.transpileModule( source, { compilerOptions: { module: ts.ModuleKind.CommonJS } } ).outputText, {
+		exports, require: ( id ) => id === '@wordpress/i18n' ? { __: ( s ) => s } : { runAbility: async ( ability, input ) => { calls.push( { ability, input } ); return response; } },
+	} );
+	return { generate: exports.generateTitle, calls };
+}
+test( 'draft context, permission anchor and feedback survive; bounded history excludes old candidates', async () => {
+	const f = fixture( { title: 'A useful title' } );
+	assert.equal( await f.generate( 42, 'Current draft body', { currentTitle: 'Unsaved title', currentExcerpt: '', feedback: 'Focus on practical steps', previousTitles: [ 'a', 'b', 'c', 'd', 'e', 'f' ] } ), 'A useful title' );
+	const p = f.calls[ 0 ].input;
+	assert.equal( p.context, '42' );
+	assert.equal( p.content, 'Current draft body' );
+	assert.equal( p.current_title, 'Unsaved title' );
+	assert.equal( p.current_excerpt, '' );
+	assert.equal( p.feedback, 'Focus on practical steps' );
+	assert.deepEqual( Array.from( p.previous_titles ), [ 'b', 'c', 'd', 'e', 'f' ] );
+} );
+test( 'legacy callers omit optional draft fields', async () => {
+	const f = fixture( { title: 'A title' } );
+	await f.generate( 42, 'Body' );
+	assert.deepEqual( Object.keys( f.calls[ 0 ].input ).sort(), [ 'content', 'context' ] );
+} );
+test( 'repeat candidate is rejected without another provider call', async () => {
+	const f = fixture( { title: ' Ａ Useful TITLE ' } );
+	await assert.rejects( f.generate( 42, 'Body', { previousTitles: [ 'A useful title' ] } ), /repeats a recent title/ );
+	assert.equal( f.calls.length, 1 );
+} );
+test( 'empty and malformed responses are rejected', async () => {
+	for ( const response of [ { title: '   ' }, { title: 7 }, null, 'Raw unexpected string' ] ) {
+		await assert.rejects( fixture( response ).generate( 42, 'Body' ), /No title suggestion/ );
+	}
+} );
