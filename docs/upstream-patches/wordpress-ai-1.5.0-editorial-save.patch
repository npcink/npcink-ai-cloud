+		)
+	);
+} );
+test( 'Note resolution failure is visible separately from a saved article', async () => {
+	const { state, hook } = fixture( { resolveFailure: true } );
+	await hook.runRefinement();
+	assert.equal( state.dirty, false );
+	assert.equal( successNotices( state ).length, 0 );
+	assert.ok(
+		state.notices.some(
+			( notice ) =>
+				notice.kind === 'createWarningNotice' &&
+				/Note/.test( String( notice.args[ 0 ] ) )
+		)
+	);
+} );
+test( 'rapid repeated clicks share one active batch', async () => {
+	let release;
+	const result = new Promise( ( done ) => {
+		release = done;
+	} );
+	const { state, hook } = fixture( { onAbility: () => result } );
+	const first = hook.runRefinement();
+	const second = hook.runRefinement();
+	await Promise.resolve();
+	release( 'Refined text' );
+	await Promise.all( [ first, second ] );
+	assert.equal(
+		state.calls.filter( ( call ) => call.startsWith( 'generate:' ) ).length,
+		1
+	);
+} );
+test( 'an incomplete Notes page aborts instead of applying a partial batch', async () => {
+	const { state, hook } = fixture( { pageFailure: true } );
+	await hook.runRefinement();
+	assert.deepEqual( state.calls, [] );
+	assert.ok(
+		state.notices.some( ( notice ) => notice.kind === 'createErrorNotice' )
+	);
+} );
+
+test( 'a resolved save with unchanged persisted content is not confirmation', async () => {
+	const { state, hook } = fixture( { unconfirmedSave: true } );
+	await hook.runRefinement();
+	assert.deepEqual( state.noteStatuses, {} );
+	assert.equal( successNotices( state ).length, 0 );
+	assert.equal( state.dirty, true );
+	assert.ok( state.notices.some( ( n ) => n.kind === 'createErrorNotice' ) );
+} );
+
+test( 'an empty model result never saves or completes Notes', async () => {
+	const { state, hook } = fixture( { onAbility: async () => '  ' } );
+	await hook.runRefinement();
+	assert.ok( ! state.calls.includes( 'save' ) );
+	assert.deepEqual( state.noteStatuses, {} );
+	assert.ok( state.notices.some( ( n ) => n.kind === 'createErrorNotice' ) );
+} );
