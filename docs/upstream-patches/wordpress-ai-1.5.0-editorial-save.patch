@@ -0,0 +1,341 @@
+/** Regression tests of the actual hook with WordPress stores and transport doubles. */
+const { test } = require( 'node:test' );
+const assert = require( 'node:assert/strict' );
+const { readFileSync } = require( 'node:fs' );
+const { resolve, dirname } = require( 'node:path' );
+const vm = require( 'node:vm' );
+const ts = require( 'typescript' );
+
+function fixture( options = {} ) {
+	const count = options.count || 1;
+	const state = {
+		postId: 42,
+		dirty: !! options.dirty,
+		saveFailed: false,
+		blocks: Array.from( { length: count }, ( _, i ) => ( {
+			clientId: `block-${ i }`,
+			name: 'core/paragraph',
+			attributes: {
+				content: `Original ${ i }`,
+				metadata: { noteId: 101 + i },
+			},
+			innerBlocks: [],
+		} ) ),
+		calls: [],
+		notices: [],
+		noteStatuses: {},
+	};
+	const content = () => JSON.stringify( state.blocks );
+	state.savedContent = content();
+	const pending = state.blocks.map( ( block ) => ( {
+		id: block.attributes.metadata.noteId,
+		parent: 0,
+		content: { rendered: 'Fix the grammar.' },
+	} ) );
+	const editor = {
+		getCurrentPostId: () => state.postId,
+		getEditedPostContent: content,
+		getCurrentPostAttribute: () => state.savedContent,
+		isEditedPostDirty: () => state.dirty,
+		isSavingPost: () => !! options.saving,
+		isPostSavingLocked: () => false,
+		isEditedPostSaveable: () => true,
+		didPostSaveRequestFail: () => state.saveFailed,
+		getCurrentPostLastRevisionId: () => 77,
+		getEditorSettings: () => ( { disableVisualRevisions: true } ),
+	};
+	const editorDispatch = {
+		async savePost() {
+			state.calls.push( 'save' );
+			if ( options.unconfirmedSave ) {
+				return;
+			}
+			if ( options.saveFailure ) {
+				state.saveFailed = true;
+				return;
+			}
+			state.savedContent = content();
+			state.dirty = false;
+		},
+		lockPostSaving() {},
+		unlockPostSaving() {},
+		lockPostAutosaving() {},
+		unlockPostAutosaving() {},
+	};
+	const stores = {
+		editor,
+		blocks: {
+			getBlocks: () => state.blocks,
+			getBlock: ( id ) => state.blocks.find( ( b ) => b.clientId === id ),
+		},
+		core: { getEntityRecords: () => pending },
+	};
+	const actions = {
+		editor: editorDispatch,
+		blocks: {
+			updateBlockAttributes( id, attrs ) {
+				state.calls.push( `apply:${ id }` );
+				Object.assign(
+					state.blocks.find( ( b ) => b.clientId === id ).attributes,
+					attrs
+				);
+				state.dirty = true;
+			},
+		},
+		core: { invalidateResolutionForStoreSelector() {} },
+		notices: {
+			removeNotice() {},
+			...Object.fromEntries(
+				[
+					'createNotice',
+					'createErrorNotice',
+					'createWarningNotice',
+					'createSuccessNotice',
+				].map( ( kind ) => [
+					kind,
+					( ...args ) => state.notices.push( { kind, args } ),
+				] )
+			),
+		},
+	};
+	const mockData = {
+		select: ( store ) => stores[ store ],
+		dispatch: ( store ) => actions[ store ],
+		useSelect: ( callback ) => callback( ( store ) => stores[ store ] ),
+	};
+	const apiFetch = async ( request ) => {
+		if ( request.method === 'PUT' ) {
+			const id = Number( request.path.split( '/' ).pop() );
+			state.calls.push( `resolve:${ id }` );
+			if ( options.resolveFailure ) {
+				throw new Error( 'Note service unavailable' );
+			}
+			state.noteStatuses[ id ] = 'approved';
+			return { id, status: 'approved' };
+		}
+		if ( request.path.includes( '/revisions?' ) ) {
+			return [ { id: 77 } ];
+		}
+		if ( options.pageFailure ) {
+			if ( request.path.endsWith( 'page=1' ) ) {
+				return Array.from( { length: 100 }, ( _, i ) => ( {
+					...pending[ 0 ],
+					id: 101 + i,
+				} ) );
+			}
+			throw new Error( 'Notes page unavailable' );
+		}
+		return pending;
+	};
+	const mocks = {
+		'@wordpress/api-fetch': { default: apiFetch },
+		'@wordpress/data': mockData,
+		'@wordpress/block-editor': { store: 'blocks' },
+		'@wordpress/editor': { store: 'editor' },
+		'@wordpress/edit-post': { store: 'editPost' },
+		'@wordpress/core-data': { store: 'core' },
+		'@wordpress/notices': { store: 'notices' },
+		'@wordpress/blocks': {
+			serialize: ( blocks ) => JSON.stringify( blocks ),
+		},
+		'@wordpress/element': {
+			useState: ( value ) => [ value, () => {} ],
+			useRef: ( value ) => ( { current: value } ),
+		},
+		'@wordpress/i18n': {
+			__: ( text ) => text,
+			_n: ( one, many, n ) => ( n === 1 ? one : many ),
+			sprintf: ( text, ...values ) => {
+				let i = 0;
+				return text.replace( /%(?:(\d+)\$)?[ds]/g, ( _, index ) =>
+					String( values[ index ? Number( index ) - 1 : i++ ] )
+				);
+			},
+		},
+	};
+	const cache = new Map();
+	function load( path ) {
+		if ( cache.has( path ) ) {
+			return cache.get( path );
+		}
+		const result = { exports: {} };
+		cache.set( path, result.exports );
+		const source = ts.transpileModule( readFileSync( path, 'utf8' ), {
+			compilerOptions: {
+				module: ts.ModuleKind.CommonJS,
+				target: ts.ScriptTarget.ES2022,
+			},
+		} ).outputText;
+		const requireMock = ( id ) => {
+			if ( mocks[ id ] ) {
+				return { __esModule: true, ...mocks[ id ] };
+			}
+			if ( id.endsWith( '/provider-status' ) ) {
+				return { ensureProvider: () => true };
+			}
+			if ( id.endsWith( '/run-ability' ) ) {
+				return {
+					runAbility: async ( _, input ) => {
+						state.calls.push( `generate:${ input.block_content }` );
+						if ( options.onAbility ) {
+							return options.onAbility( input, state );
+						}
+						if (
+							options.partialFailure &&
+							input.block_content.endsWith( '1' )
+						) {
+							throw new Error( 'One block failed' );
+						}
+						return `Refined ${ input.block_content }`;
+					},
+				};
+			}
+			if ( id.startsWith( '.' ) ) {
+				return load( resolve( dirname( path ), `${ id }.ts` ) );
+			}
+			throw new Error( `Unexpected import ${ id }` );
+		};
+		vm.runInNewContext(
+			source,
+			{
+				exports: result.exports,
+				module: result,
+				require: requireMock,
+				window: {
+					aiEditorialUpdatesData: {
+						rest_base: 'posts',
+						admin_url: 'https://example.test/wp-admin/',
+					},
+				},
+				console: { warn() {} },
+				setTimeout,
+			},
+			{ filename: path }
+		);
+		return result.exports;
+	}
+	const hook = load(
+		resolve(
+			__dirname,
+			'../../src/experiments/editorial-updates/hooks/useEditorialUpdates.ts'
+		)
+	).useEditorialUpdates();
+	return { state, hook };
+}
+
+const successNotices = ( state ) =>
+	state.notices.filter( ( notice ) => notice.kind === 'createSuccessNotice' );
+
+test( 'save failure never resolves Notes or reports refinement success', async () => {
+	const { state, hook } = fixture( { saveFailure: true } );
+	await hook.runRefinement();
+	assert.equal(
+		state.calls.filter( ( call ) => call.startsWith( 'resolve:' ) ).length,
+		0
+	);
+	assert.equal( successNotices( state ).length, 0 );
+	assert.equal( state.dirty, true );
+	assert.match( String( state.notices.at( -1 ).args[ 0 ] ), /sav/i );
+} );
+test( 'native save resolves undefined: check persisted state before resolving Notes', async () => {
+	const { state, hook } = fixture();
+	await hook.runRefinement();
+	assert.ok(
+		state.calls.indexOf( 'save' ) < state.calls.indexOf( 'resolve:101' )
+	);
+	assert.equal( state.noteStatuses[ 101 ], 'approved' );
+	assert.equal( successNotices( state ).length, 1 );
+} );
+test( 'existing unsaved edits are preserved without generation or auto-save', async () => {
+	const { state, hook } = fixture( { dirty: true } );
+	await hook.runRefinement();
+	assert.deepEqual( state.calls, [] );
+	assert.equal( state.dirty, true );
+} );
+test( 'a save already in flight prevents a new batch', async () => {
+	const { state, hook } = fixture( { saving: true } );
+	await hook.runRefinement();
+	assert.deepEqual( state.calls, [] );
+} );
+test( 'typing during generation never gets overwritten or auto-saved', async () => {
+	const { state, hook } = fixture( {
+		onAbility: async ( input, current ) => {
+			current.blocks[ 0 ].attributes.content = 'New human draft';
+			current.dirty = true;
+			return 'Stale generated text';
+		},
+	} );
+	await hook.runRefinement();
+	assert.equal( state.blocks[ 0 ].attributes.content, 'New human draft' );
+	assert.ok( ! state.calls.includes( 'save' ) );
+	assert.deepEqual( state.noteStatuses, {} );
+} );
+test( 'partial failure saves only successful blocks and keeps a visible warning', async () => {
+	const { state, hook } = fixture( { count: 2, partialFailure: true } );
+	await hook.runRefinement();
+	assert.equal( state.noteStatuses[ 101 ], 'approved' );
+	assert.equal( state.noteStatuses[ 102 ], undefined );
