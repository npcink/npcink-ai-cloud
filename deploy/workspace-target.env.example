#!/usr/bin/env bash

# Example workspace deploy target. Copy to a local-only secrets file:
#   mkdir -p .deploy-secrets && chmod 700 .deploy-secrets
#   cp deploy/workspace-target.env.example .deploy-secrets/workspace-target.env.sh
#   chmod 600 .deploy-secrets/workspace-target.env.sh
# Then edit the real host/user/domain in that secrets file (never commit it).
#
# Or set the same variables in your shell before sourcing
# deploy/workspace-target.env.sh — pre-exported values always win.
#
# Placeholders below use TEST-NET / example domains only.

export NPCINK_CLOUD_DEPLOY_SSH_HOST="${NPCINK_CLOUD_DEPLOY_SSH_HOST:-203.0.113.10}"
export NPCINK_CLOUD_DEPLOY_SSH_USER="${NPCINK_CLOUD_DEPLOY_SSH_USER:-deploy}"
export NPCINK_CLOUD_BASE_URL="${NPCINK_CLOUD_BASE_URL:-https://cloud.example.test}"
export NPCINK_CLOUD_DOMAIN_NAME="${NPCINK_CLOUD_DOMAIN_NAME:-cloud.example.test}"
export NPCINK_CLOUD_DOMAIN_UPSTREAM_URL="${NPCINK_CLOUD_DOMAIN_UPSTREAM_URL:-http://127.0.0.1:8010}"

# Optional overrides. Keep commented until the real values are confirmed.
# export NPCINK_CLOUD_DEPLOY_IDENTITY_FILE="/path/to/operator-held-key.pem"
# The Edge helper consumes remote Certbot live-lineage paths directly; it does
# not upload workstation certificate or private-key files.
# export NPCINK_CLOUD_DEPLOY_REMOTE_DIR="/opt/npcink-ai-cloud"
# export NPCINK_CLOUD_ENV_FILE=".env.deploy"
# export NPCINK_CLOUD_WP_CRON_SITE_BASE_URL="https://example-wordpress-site.test"
# export NPCINK_CLOUD_WP_CRON_SCHEDULE="*/5 * * * *"
# export NPCINK_CLOUD_WP_CRON_CURL_TIMEOUT_SECONDS="90"
