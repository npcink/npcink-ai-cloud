{
  "version": 9,
  "standard": "../docs/cloud-admin-ui-standard-v1.md",
  "referenceRoute": "/admin/ai-resources",
  "referenceRoutes": {
    "queue": "/admin/ai-resources",
    "configuration": "/admin/external-services",
    "diagnostic": "/admin/troubleshooting"
  },
  "viewport": {
    "width": 1440,
    "height": 1050
  },
  "geometry": {
    "sidebarExpandedPx": 208,
    "sidebarCollapsedPx": 64,
    "workbenchMaxWidthPx": 1152,
    "workbenchCompactMaxWidthPx": 960
  },
  "surfacePolicy": {
    "configurationTableBoundary": "header-only",
    "dataTableBoundary": "rows",
    "dialogBoundary": "solid",
    "formControlBoundary": "solid",
    "dashedBoundaryPrimitive": "AdminEmptyState"
  },
  "visualGovernance": {
    "version": 1,
    "receiptSchema": "admin-visual-receipt.schema.json",
    "resultStates": [
      "pass",
      "fail",
      "review_required",
      "not_applicable",
      "unmeasured"
    ],
    "riskTiers": {
      "low": "copy, data labels, or non-visual logic with no geometry or interaction change",
      "material": "route layout, table, form, state, action hierarchy, dialog, or inspector change",
      "shared": "Admin shell, shared primitive, geometry token, or cross-route interaction change"
    },
    "rules": [
      {
        "id": "declared-page-model",
        "authority": "hard_gate"
      },
      {
        "id": "pc-viewport",
        "authority": "hard_gate"
      },
      {
        "id": "horizontal-overflow",
        "authority": "hard_gate"
      },
      {
        "id": "single-page-title",
        "authority": "hard_gate"
      },
      {
        "id": "working-surface-first-viewport",
        "authority": "hard_gate"
      },
      {
        "id": "single-primary-action",
        "authority": "hard_gate"
      },
      {
        "id": "textual-status",
        "authority": "hard_gate"
      },
      {
        "id": "action-object-proximity",
        "authority": "hard_gate"
      },
      {
        "id": "distinct-interaction-states",
        "authority": "hard_gate"
      },
      {
        "id": "dialog-focus-recovery",
        "authority": "hard_gate"
      },
      {
        "id": "context-stability",
        "authority": "hard_gate"
      },
      {
        "id": "browser-runtime-errors",
        "authority": "hard_gate"
      }
    ],
    "pilotRoutes": {
      "/admin/usage-statistics": {
        "pageModel": "diagnostic",
        "riskTier": "material",
        "workingSurface": "[data-ui=\"usage-statistics-workspace\"]",
        "requiredStates": [
          "ready",
          "filtered",
          "partial_error"
        ],
        "browserSpec": "tests/e2e/admin-usage-statistics.spec.ts"
      },
      "/admin/plugin-observability": {
        "pageModel": "diagnostic",
        "riskTier": "material",
        "workingSurface": "[data-ui=\"plugin-problems\"]",
        "requiredStates": [
          "ready",
          "selected",
          "partial_error",
          "disclosure"
        ],
        "browserSpec": "tests/e2e/admin-plugin-observability-v2.spec.ts"
      },
      "/admin/ai-resources": {
        "pageModel": "queue",
        "riskTier": "material",
        "workingSurface": "[data-ui=\"model-supplier-directory\"]",
        "requiredStates": [
          "ready",
          "selected",
          "filtered",
          "operation_error",
          "dialog"
        ],
        "browserSpec": "tests/e2e/admin-provider-directory-v2.spec.ts"
      },
      "/admin/coverage": {
        "pageModel": "queue",
        "riskTier": "material",
        "workingSurface": "[data-ui=\"coverage-workspace\"]",
        "requiredStates": [
          "ready",
          "filtered",
          "paginated",
          "selected",
          "refresh_error"
        ],
        "browserSpec": "tests/e2e/admin-service-queue-v2.spec.ts"
      },
      "/admin/service-settings": {
        "pageModel": "configuration",
        "riskTier": "material",
        "workingSurface": "[data-ui=\"admin-settings-workbench\"]",
        "requiredStates": [
          "ready",
          "invalid",
          "dirty",
          "save_error",
          "saved",
          "dialog"
        ],
        "browserSpec": "tests/e2e/admin-service-settings-v2.spec.ts"
      },
      "/admin/troubleshooting": {
        "pageModel": "diagnostic",
        "riskTier": "material",
        "workingSurface": "[data-ui=\"runtime-diagnostic-table-frame\"]",
        "requiredStates": [
          "ready",
          "selected",
          "partial_error",
          "disclosure"
        ],
        "browserSpec": "tests/e2e/admin-runtime-diagnostics-v2.spec.ts"
      },
      "/admin/audit": {
        "pageModel": "diagnostic",
        "riskTier": "material",
        "workingSurface": "[data-ui=\"admin-audit-directory\"]",
        "requiredStates": [
          "ready",
          "filtered",
          "selected",
          "refresh_error"
        ],
        "browserSpec": "tests/e2e/admin-audit-workspace.spec.ts"
      },
      "/admin/support-requests": {
        "pageModel": "queue",
        "riskTier": "material",
        "workingSurface": "[data-ui=\"support-request-table\"]",
        "requiredStates": [
          "ready",
          "filtered",
          "selected",
          "returned"
        ],
        "browserSpec": "tests/e2e/admin-support-request-operator-closure.spec.ts"
      },
      "/admin/support-requests/[requestId]": {
        "pageModel": "detail",
        "riskTier": "material",
        "workingSurface": "[data-ui=\"support-request-detail-workspace\"]",
        "requiredStates": [
          "ready",
          "action_error",
          "action_success",
          "return_context"
        ],
        "browserSpec": "tests/e2e/admin-support-request-operator-closure.spec.ts"
      }
    },
    "browserLanes": {
      "local": "required for every material or shared Admin visual change",
      "m4": "required for a new reference pattern, Admin shell, shared primitive, or major cross-route visual change"
    },
    "humanAcceptance": "required for new golden baselines and material shared visual patterns",
    "supplementalSpecs": [
      "tests/e2e/admin-accounts-queue-v2.spec.ts",
      "tests/e2e/admin-credit-packs-directory-v2.spec.ts",
      "tests/e2e/admin-customer-detail-v2.spec.ts",
      "tests/e2e/admin-external-services.spec.ts",
      "tests/e2e/admin-vector-settings.spec.ts",
      "tests/e2e/admin-runtime-profiles-workspace.spec.ts",
      "tests/e2e/admin-site-compliance-workspace.spec.ts"
    ]
  },
  "pageModels": [
    "overview",
    "queue",
    "detail",
    "configuration",
    "diagnostic",
    "authentication"
  ],
  "routes": {
    "/admin": "overview",
    "/admin/login": "authentication",
    "/admin/accounts": "queue",
    "/admin/accounts/[accountId]": "detail",
    "/admin/sites/[siteId]": "detail",
    "/admin/coverage": "queue",
    "/admin/subscriptions": "queue",
    "/admin/subscriptions/[subscriptionId]": "detail",
    "/admin/support-requests": "queue",
    "/admin/support-requests/[requestId]": "detail",
    "/admin/plans": "queue",
    "/admin/credit-packs": "configuration",
    "/admin/ai-resources": "queue",
    "/admin/external-services": "configuration",
    "/admin/vector-settings": "configuration",
    "/admin/runtime-profiles": "configuration",
    "/admin/troubleshooting": "diagnostic",
    "/admin/audit": "diagnostic",
    "/admin/plugin-observability": "diagnostic",
    "/admin/media-observability": "diagnostic",
    "/admin/vector-observability": "diagnostic",
    "/admin/agent-feedback": "diagnostic",
    "/admin/ai-advisor": "diagnostic",
    "/admin/service-settings": "configuration",
    "/admin/site-compliance": "configuration",
    "/admin/usage-statistics": "diagnostic"
  },
  "legacyRouteLocalDialogs": [],
  "legacyRouteLocalCredentials": []
}
